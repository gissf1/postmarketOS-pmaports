pkgname=postmarketos-initramfs
pkgver=3.9.0
pkgrel=0
pkgdesc="Base files for the postmarketOS initramfs / initramfs-extra"
url="https://postmarketos.org"
options="!check"  # no tests
provides="postmarketos-ramdisk=$pkgver-r$pkgrel"
provider_priority=10
depends="
	blkid
	btrfs-progs
	buffyboard
	busybox-extras
	bzip2
	cryptsetup
	device-mapper
	devicepkg-utils>=0.2.0
	dosfstools
	e2fsprogs
	e2fsprogs-extra
	f2fs-tools
	font-terminus
	iskey
	kmod
	libinput-libs
	lz4
	multipath-tools
	parted
	postmarketos-fde-unlocker
	postmarketos-mkinitfs>=2.2
	udev
	unudhcpd
	util-linux-misc
	xz
	"
makedepends="
	postmarketos-base-nofde
"
arch="noarch"
license="GPL-2.0-or-later"
subpackages="$pkgname-duranium"

_source644="
	etc/unudhcpd.conf
	usr/lib/repart.d/00-esp.conf
	usr/lib/repart.d/10-usr-verity-sig.conf
	usr/lib/repart.d/11-usr-verity.conf
	usr/lib/repart.d/12-usr.conf
	usr/lib/repart.d/20-usr-verity-sig.conf
	usr/lib/repart.d/21-usr-verity.conf
	usr/lib/repart.d/22-usr.conf
	usr/lib/repart.d/30-root.conf
	usr/lib/sysupdate.d/10-usr-verity-sig.transfer
	usr/lib/sysupdate.d/11-usr-verify.transfer
	usr/lib/sysupdate.d/12-usr.transfer
	usr/lib/sysupdate.d/20-esp.transfer
	usr/lib/sysusers.d/10-pmos-user.conf
	usr/lib/tmpfiles.d/etc.conf
	usr/lib/tmpfiles.d/opt.conf
	usr/lib/tmpfiles.d/var.conf
	usr/share/initramfs/init_functions.sh
	usr/share/initramfs/init_functions_2nd.sh
	usr/share/initramfs/mdev.conf
	usr/share/mkinitfs/dirs/00-initramfs-base.dirs
	usr/share/mkinitfs/files-extra/00-initramfs-extra-base.files
	usr/share/mkinitfs/files/00-initramfs-base.files
	usr/share/mkinitfs/files/10-duranium-base.files
	usr/share/mkinitfs/modules/00-default.modules
	usr/share/mkinitfs/modules/10-duranium-base.modules
"
_source755="
	usr/share/initramfs/init.sh
	usr/share/initramfs/init_2nd.sh
"

# Avoid filename based checksum conflicts by including the whole path:
# https://gitlab.alpinelinux.org/alpine/abuild/-/issues/10013
flatpath() {
	local i
	for i in $@; do
		echo "rootfs-$i" | sed s./.-.g
	done
}
source="$(flatpath $_source440 $_source600 $_source644 $_source755)"

build() {
	mkdir -p "$builddir"

	# Replace <<INITRAMFS_PKG_VERSION>> with the actual version
	sed -i "s|<<INITRAMFS_PKG_VERSION>>|$pkgver-r$pkgrel|" \
		"$srcdir/rootfs-usr-share-initramfs-init.sh"
}

package() {
	for i in $_source644; do
		install -Dm644 "$srcdir/$(flatpath "$i")" "$pkgdir/$i"
	done
	for i in $_source755; do
		install -Dm755 "$srcdir/$(flatpath "$i")" "$pkgdir/$i"
	done

	mkdir -p "$pkgdir"/usr/share/mkinitfs/hooks
	mkdir -p "$pkgdir"/usr/share/mkinitfs/hooks-extra
	mkdir -p "$pkgdir"/etc/mkinitfs/hooks
	mkdir -p "$pkgdir"/etc/mkinitfs/hooks-extra
}

duranium() {
	replaces="systemd"  # For overwriting tmpfiles.d/{etc,var}.conf
	depends="jq"

	amove usr/share/mkinitfs/files/10-duranium-base.files
	amove usr/share/mkinitfs/modules/10-duranium-base.modules
	amove usr/lib/repart.d/00-esp.conf
	amove usr/lib/repart.d/10-usr-verity-sig.conf
	amove usr/lib/repart.d/11-usr-verity.conf
	amove usr/lib/repart.d/12-usr.conf
	amove usr/lib/repart.d/20-usr-verity-sig.conf
	amove usr/lib/repart.d/21-usr-verity.conf
	amove usr/lib/repart.d/22-usr.conf
	amove usr/lib/repart.d/30-root.conf
	amove usr/lib/sysupdate.d/10-usr-verity-sig.transfer
	amove usr/lib/sysupdate.d/11-usr-verify.transfer
	amove usr/lib/sysupdate.d/12-usr.transfer
	amove usr/lib/sysupdate.d/20-esp.transfer
	amove usr/lib/sysusers.d/10-pmos-user.conf
	amove usr/lib/tmpfiles.d/etc.conf
	amove usr/lib/tmpfiles.d/opt.conf
	amove usr/lib/tmpfiles.d/var.conf
}

