c6a4c37d094836337e71702c0aa9fed6dd590dd82140cf4ef6cf3e0841d0c5ab2cbd12a6fd0b6cdad3f521c034c19d8473f365713149ddfb8a34e9a24cc76110  arm64-dts-exynos-gs101-bluejay-add-new-board-file.patch
