# Contributor: 
# Maintainer:
pkgname=linux-gpib
pkgver=4.3.6
pkgrel=0
pkgdesc="Linux GPIB userland applications"
url="https://sourceforge.net/projects/linux-gpib"
arch="all"
license="GPL-2.0-only"
depends="fxload
	linux-gpib-firmware
	python3
	py3-setuptools"
options="pmb:cross-native"
makedepends="docbook-xml linux-headers pkgconf python3-dev py3-setuptools"
checkdepends=""
install=""
subpackages="$pkgname-dev $pkgname-doc"
source="https://downloads.sourceforge.net/linux-gpib/linux-gpib-$pkgver.tar.gz
	0000-ptread.patch
	0001-libgpib-pc.patch
	0002-usb-fxloader.patch"
#
# We are only-interested in the user part, as kernels >6.13 have the GPIB drivers included (still need configuring)
builddir="$srcdir/$pkgname-user-$pkgver"

unpack() {
        default_unpack
        tar -xzf "$srcdir/$pkgname-$pkgver/$pkgname-user-$pkgver".tar.gz -C "$srcdir"
}


build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--datadir=/lib/firmware \
		--localstatedir=/var \
		--disable-guile-binding \
		--disable-perl-binding \
		--disable-php-binding \
		--disable-tcl-binding \
		--enable-documentation

	make
}

check() {
	make check
}

doc() {
	_docs="gpib_version.txt  linux-gpib.pdf  linux-gpib.sgml"
	for _doc in $_docs; do
		install -Dm644 "$srcdir"/$pkgname-user-$pkgver/doc/$_doc \
			"$subpkgdir"/usr/share/doc/$pkgname/$_doc || return 1
	done
}

package() {
	make DESTDIR="$pkgdir" install
}

