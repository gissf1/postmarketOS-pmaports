# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-anbernic-rg35xx
pkgdesc="Anbernic RG35XX Series"
pkgver=1
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-anbernic-rg35xx
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	extlinux.conf
	30-device-firmware.files
	anbernic,rg35xx-sp-v2-panel.panel
	rtl8821cs_fw.bin
	rtw8821c_fw.bin
	rg35xx-control-mapper.py
	rg35xx-control-mapper.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/extlinux.conf \
		"$pkgdir"/boot/extlinux/extlinux.conf
	install -Dm644 "$srcdir"/30-device-firmware.files "$pkgdir/usr/share/mkinitfs/files/30-device-firmware.files"
	install -Dm644 "$srcdir"/anbernic,rg35xx-sp-v2-panel.panel \
		"$pkgdir"/lib/firmware/panels/anbernic,rg35xx-sp-v2-panel.panel

	install -Dm644 "$srcdir"/rtl8821cs_fw.bin \
		"$pkgdir"/lib/firmware/rtl_bt/rtl8821cs_fw.bin

	install -Dm644 "$srcdir"/rtw8821c_fw.bin \
		"$pkgdir"/lib/firmware/rtw88/rtw8821c_fw.bin

	install -Dm755 "$srcdir"/rg35xx-control-mapper.py \
		"$pkgdir"/usr/bin/rg35xx-control-mapper
	install -Dm644 "$srcdir"/rg35xx-control-mapper.service \
		"$pkgdir"/usr/lib/systemd/system/rg35xx-control-mapper.service
}

