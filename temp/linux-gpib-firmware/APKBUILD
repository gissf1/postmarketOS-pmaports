pkgname=linux-gpib-firmware
pkgver=1
pkgrel=0
pkgdesc="firmware files for use with Linux-GPIB interfaces"
url="https://github.com/fmhess/linux_gpib_firmware"
_commit="8a5c6c2c1a2adac4c770763a7236452a871a0113"
options="!check pmb:cross-native"
arch="noarch"
license="proprietary"
source="https://github.com/fmhess/linux_gpib_firmware/archive/$_commit.tar.gz"
builddir="$srcdir/"

package() {
	mkdir -p "$pkgdir"/lib/firmware/gpib
	# remove a binary which can be rebuild easily from source.
	rm "$srcdir/linux_gpib_firmware-$_commit"/hp_82341/generate_firmware
	cp -r "$srcdir/linux_gpib_firmware-$_commit/"* \
		"$pkgdir"/lib/firmware/gpib/
}

sha512sums="
